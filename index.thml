<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VocabMaster - เรียนรู้คำศัพท์ภาษาอังกฤษ 600+ คำ</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Kanit', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <style>
    .gradient-bg { background: linear-gradient(135deg, #f3e8ff 0%, #fce7f3 100%); }
    .gradient-btn { background: linear-gradient(135deg, #a855f7 0%, #ec4899 100%); }
    .gradient-btn:hover { background: linear-gradient(135deg, #9333ea 0%, #db2777 100%); }
    .gradient-text {
      background: linear-gradient(135deg, #a855f7 0%, #ec4899 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .highlight-match {
      background-color: #fef08a;
      color: #854d0e;
      padding: 0 4px;
      border-radius: 4px;
      font-weight: bold;
    }
    
    /* Futuristic Loading Modal FX */
    @keyframes pulse-ring {
      0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(168, 85, 247, 0.7); }
      70% { transform: scale(1); box-shadow: 0 0 0 20px rgba(168, 85, 247, 0); }
      100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(168, 85, 247, 0); }
    }
    .glow-pulse {
      animation: pulse-ring 2s infinite;
    }

    @keyframes progress-anim {
      0% { width: 0%; }
      50% { width: 70%; }
      100% { width: 100%; }
    }
    .animate-progress {
      animation: progress-anim 1.2s ease-in-out forwards;
    }

    /* Flying Creature Animation */
    @keyframes floatFly {
      0% {
        transform: translate(0, 0) scale(0.8) rotate(0deg);
        opacity: 0;
      }
      10% { opacity: 0.8; }
      50% {
        transform: translate(40vw, -30vh) scale(1.1) rotate(15deg);
      }
      90% { opacity: 0.8; }
      100% {
        transform: translate(95vw, -60vh) scale(0.7) rotate(-10deg);
        opacity: 0;
      }
    }
    .creature {
      position: fixed;
      pointer-events: none;
      z-index: 1;
      font-size: 1.5rem;
      filter: drop-shadow(0 4px 6px rgba(168, 85, 247, 0.3));
    }
    .c1 { left: -5%; bottom: 10%; animation: floatFly 18s ease-in-out infinite; }
    .c2 { left: -10%; bottom: 35%; animation: floatFly 24s ease-in-out 6s infinite; }
    .c3 { left: -8%; bottom: 60%; animation: floatFly 21s ease-in-out 12s infinite; }
  </style>
</head>
<body class="gradient-bg min-h-screen text-slate-800 font-sans antialiased flex flex-col justify-between selection:bg-pink-300 selection:text-purple-900 relative overflow-x-hidden">

  <!-- Ambient Flying Wildlife Elements -->
  <div class="creature c1">🦋</div>
  <div class="creature c2">🕊️</div>
  <div class="creature c3">✨</div>

  <!-- HTML5 Audio Element for Lo-Fi Background Music (Guaranteed Sound) -->
  <audio id="lofi-audio" loop preload="auto">
    <source src="TunePocket-Midnight-Glow-1-Hour-Piano-Relaxation-Preview.mp3" type="audio/mpeg">
  </audio>

  <!-- Main View Wrap -->
  <div class="container mx-auto px-4 py-6 max-w-4xl flex-grow flex flex-col justify-center relative z-10">

    <!-- Auth View Container -->
    <div id="auth-view" class="w-full max-w-md mx-auto my-auto py-4">
      
      <!-- Login Card -->
      <div id="login-card" class="bg-white/95 backdrop-blur-md rounded-3xl p-7 md:p-8 shadow-2xl border border-purple-100">
        <div class="text-center mb-6">
          <span class="text-4xl">🚀</span>
          <h2 class="text-2xl font-bold gradient-text mt-2">เข้าสู่ระบบ VocabMaster</h2>
          <p class="text-slate-500 text-sm mt-1">เรียนรู้คำศัพท์ 600+ คำจาก 10+ หน้า</p>
        </div>
        
        <div id="login-error-msg" class="text-xs text-red-500 font-bold hidden text-center bg-red-50 py-2.5 px-3 rounded-xl border border-red-200 mb-4"></div>

        <form id="login-form" onsubmit="handleLogin(event)" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1">อีเมล (Email)</label>
            <input type="email" id="login-email" required placeholder="user@example.com" class="w-full px-4 py-3 rounded-2xl border border-purple-200 outline-none focus:border-pink-500 focus:ring-2 focus:ring-pink-200 text-sm transition">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1">รหัสผ่าน (Password)</label>
            <div class="relative">
              <input type="password" id="login-pass" required placeholder="••••••••" class="w-full px-4 py-3 pr-10 rounded-2xl border border-purple-200 outline-none focus:border-pink-500 focus:ring-2 focus:ring-pink-200 text-sm transition">
              <button type="button" onclick="togglePassVisibility(['login-pass'], this)" class="absolute right-3 top-3 text-slate-400 hover:text-purple-600 focus:outline-none">👁️</button>
            </div>
          </div>
          <button type="submit" class="w-full py-3.5 rounded-2xl gradient-btn text-white font-bold shadow-lg shadow-purple-500/20 active:scale-95 transition">
            เข้าสู่ระบบ
          </button>
        </form>
        <p class="text-center text-xs text-slate-500 mt-5">ยังไม่มีบัญชี? <button onclick="toggleAuth('signup')" class="text-purple-600 font-bold underline">สมัครสมาชิก</button></p>
      </div>

      <!-- Signup Card -->
      <div id="signup-card" class="hidden bg-white/95 backdrop-blur-md rounded-3xl p-7 md:p-8 shadow-2xl border border-purple-100">
        <div class="text-center mb-6">
          <span class="text-4xl">✨</span>
          <h2 class="text-2xl font-bold gradient-text mt-2">สมัครสมาชิก</h2>
          <p class="text-slate-500 text-sm mt-1">เรียนรู้คำศัพท์ 600+ คำจาก 10+ หน้า</p>
        </div>

        <div id="signup-error-msg" class="text-xs text-red-500 font-bold hidden text-center bg-red-50 py-2.5 px-3 rounded-xl border border-red-200 mb-4"></div>

        <form id="signup-form" onsubmit="handleSignup(event)" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1">ชื่อผู้ใช้ (Username)</label>
            <input type="text" id="signup-name" required placeholder="ชื่อของคุณ" class="w-full px-4 py-3 rounded-2xl border border-purple-200 outline-none focus:border-pink-500 focus:ring-2 focus:ring-pink-200 text-sm transition">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1">อีเมล (Email)</label>
            <input type="email" id="signup-email" required placeholder="user@example.com" class="w-full px-4 py-3 rounded-2xl border border-purple-200 outline-none focus:border-pink-500 focus:ring-2 focus:ring-pink-200 text-sm transition">
          </div>
          
          <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1">รหัสผ่าน (อย่างน้อย 8 ตัว มีทั้งตัวอักษรและตัวเลข)</label>
            <div class="relative">
              <input type="password" id="signup-pass" oninput="syncSignupPassword(this.value)" required placeholder="••••••••" class="w-full px-4 py-3 pr-10 rounded-2xl border border-purple-200 outline-none focus:border-pink-500 focus:ring-2 focus:ring-pink-200 text-sm transition">
              <button type="button" onclick="togglePassVisibility(['signup-pass', 'signup-pass-confirm'], this)" class="absolute right-3 top-3 text-slate-400 hover:text-purple-600 focus:outline-none" title="เปิด/ปิดดูรหัสผ่าน">👁️</button>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-500 mb-1">ยืนยันรหัสผ่าน (Confirm Password)</label>
            <input type="password" id="signup-pass-confirm" required placeholder="••••••••" class="w-full px-4 py-3 rounded-2xl border border-purple-200 outline-none focus:border-pink-500 focus:ring-2 focus:ring-pink-200 text-sm transition bg-slate-50">
          </div>

          <button type="submit" class="w-full py-3.5 rounded-2xl gradient-btn text-white font-bold shadow-lg shadow-purple-500/20 active:scale-95 transition">
            ลงทะเบียน
          </button>
        </form>
        <p class="text-center text-xs text-slate-500 mt-5">มีบัญชีอยู่แล้ว? <button onclick="toggleAuth('login')" class="text-purple-600 font-bold underline">เข้าสู่ระบบ</button></p>
      </div>

    </div>

    <!-- Main View (After Login) -->
    <div id="main-view" class="hidden w-full my-4">
      <header class="bg-white/90 backdrop-blur-md rounded-3xl p-6 shadow-xl shadow-purple-950/5 border border-purple-100 text-center mb-6">
        <div class="flex items-center justify-between mb-4 pb-4 border-b border-purple-100 flex-wrap gap-2">
          <div class="flex items-center gap-2">
            <span class="text-2xl">📚</span>
            <span class="font-bold text-slate-700 text-sm" id="user-display">สวัสดีผู้ใช้งาน</span>
          </div>

          <div class="flex items-center gap-2">
            <div class="flex items-center gap-2 bg-purple-50 px-3 py-1.5 rounded-xl border border-purple-200">
              <span class="text-xs font-bold text-purple-700 flex items-center gap-1">
                <span class="animate-pulse">🎧</span> Lo-fi Music
              </span>
              <button onclick="toggleMusic()" id="music-play-btn" class="text-xs font-bold bg-purple-600 text-white px-2.5 py-1 rounded-lg hover:bg-purple-700 transition">
                ▶️ เล่นเพลง
              </button>
            </div>

            <button onclick="openLogoutConfirmModal()" class="px-3.5 py-1.5 rounded-xl bg-red-50 text-red-600 text-xs font-bold hover:bg-red-100 transition">ออกจากระบบ</button>
          </div>
        </div>

        <h1 class="text-2xl md:text-3xl font-extrabold gradient-text">คลังคำศัพท์และประโยคภาษาอังกฤษ 600+ คำ</h1>
        <p class="text-slate-500 text-xs md:text-sm mt-1.5">แบ่งออกเป็น 11 หน้า หน้าละ 60 คำศัพท์ พร้อมประโยคแต่ง คำอ่านภาษาไทย และคำแปล</p>

        <!-- Page Navigation Tabs (1 - 11) -->
        <div class="mt-6 flex flex-wrap justify-center gap-1.5 md:gap-2" id="page-tabs"></div>

        <!-- Real-time Search Box (Cleaned double magnifying glass icon) -->
        <div class="mt-5 max-w-md mx-auto relative">
          <input type="text" id="search-input" oninput="handleSearch()" placeholder="ค้นหาทันที (เช่น 'alw' หรือตัวอักษร 1 ตัว)..."
            class="w-full px-5 py-3 pl-11 rounded-2xl border border-purple-200 focus:border-pink-500 focus:ring-4 focus:ring-pink-500/10 outline-none transition-all text-slate-700 bg-purple-50/30 text-sm">
          <span class="absolute left-4 top-3.5 text-slate-400">🔍</span>
        </div>
      </header>

      <!-- Sentences List Container -->
      <main class="space-y-4" id="sentences-container"></main>

      <!-- Empty State -->
      <div id="no-results" class="hidden bg-white/80 backdrop-blur-md rounded-3xl p-8 text-center text-slate-500 border border-purple-100 mt-4">
        <span class="text-3xl mb-2 inline-block">🔎</span>
        <p class="font-medium text-slate-600">ไม่พบคำศัพท์หรือประโยคที่ตรงกับคำค้นหาของคุณ</p>
      </div>
    </div>

  </div>

  <!-- Logout Confirmation Modal -->
  <div id="logout-confirm-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-6 max-w-xs w-full text-center shadow-2xl border border-purple-100">
      <span class="text-4xl mb-2 inline-block">🚪</span>
      <h3 class="text-lg font-bold text-slate-800 mb-1">ยืนยันออกจากระบบ</h3>
      <p class="text-xs text-slate-500 mb-6">คุณต้องการออกจากระบบใช่หรือไม่?</p>
      <div class="flex gap-3">
        <button onclick="closeLogoutConfirmModal()" class="flex-1 py-2.5 rounded-xl bg-slate-100 text-slate-600 font-bold text-xs hover:bg-slate-200 transition">ยกเลิก</button>
        <button onclick="confirmLogout()" class="flex-1 py-2.5 rounded-xl gradient-btn text-white font-bold text-xs shadow-md transition">ยืนยัน</button>
      </div>
    </div>
  </div>

  <!-- Ultra Cool Processing Modal Overlay -->
  <div id="processing-modal" class="fixed inset-0 bg-slate-900/80 backdrop-blur-md z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-purple-500/30 rounded-3xl p-8 max-w-sm w-full text-center shadow-2xl relative overflow-hidden">
      <div class="absolute -top-12 -left-12 w-24 h-24 bg-purple-500/20 rounded-full blur-xl"></div>
      <div class="absolute -bottom-12 -right-12 w-24 h-24 bg-pink-500/20 rounded-full blur-xl"></div>
      
      <div class="relative w-20 h-20 mx-auto mb-6 flex items-center justify-center">
        <div class="w-full h-full rounded-full border-4 border-purple-500/20 glow-pulse"></div>
        <div class="absolute inset-0 rounded-full border-t-4 border-pink-500 animate-spin"></div>
        <span class="text-2xl absolute" id="modal-icon">🛡️</span>
      </div>

      <h3 class="text-lg font-bold text-white mb-2" id="modal-title">กำลังดำเนินการ...</h3>
      <p class="text-xs text-purple-300 mb-6" id="modal-status">กำลังตรวจสอบระบบความปลอดภัย</p>
      
      <div class="w-full bg-slate-800 rounded-full h-2 overflow-hidden border border-purple-900">
        <div id="modal-progress" class="bg-gradient-to-r from-purple-500 to-pink-500 h-full rounded-full animate-progress"></div>
      </div>
    </div>
  </div>

  <footer class="text-center text-xs text-slate-500 py-4 relative z-10">
    <a href="https://chachaphon15y.github.io/3092011" target="_blank" rel="noopener noreferrer" style="color: #9333ea; text-decoration: underline; font-weight: bold;">หากพบข้อผิดพลาด ติดต่อ chachaphon15y.github.io/3092011</a>
  </footer>

  <script>
    /* 660 Target Vocabulary Words across 11 pages */
    const rawWords = {
      1: ["hometown", "yard", "grocery", "fairy", "flag", "manner", "noise", "pain", "danger", "guide", "coach", "note", "count", "sail", "promise", "repeat", "bake", "gather", "succeed", "protect", "advertise", "disappear", "electric", "lovely", "thin", "round", "deep", "wide", "yet", "quickly", "couple", "honey", "tourist", "gate", "background", "capital", "valley", "direction", "distance", "behavior", "object", "dictionary", "tear", "honor", "increase", "bite", "male", "native", "disappoint", "shine", "fix", "pour", "allow", "prevent", "certain", "mental", "comfortable", "expensive", "therefore", "everywhere"],
      2: ["person", "life", "job", "country", "earth", "problem", "way", "language", "story", "lot", "name", "hand", "place", "practice", "work", "use", "kind", "fun", "future", "have", "make", "let", "get", "take", "different", "important", "right", "sure", "well", "hard", "clothes", "movie", "activity", "example", "dialogue", "letter", "fire", "minute", "part", "plan", "plant", "park", "call", "try", "need", "keep", "listen", "find", "learn", "live", "mean", "last", "any", "each", "other", "another", "same", "too", "also", "really"],
      3: ["wood", "cave", "tomb", "tool", "satellite", "communication", "wealth", "attention", "miracle", "stream", "wave", "value", "beat", "support", "chemical", "female", "fair", "respond", "deliver", "fold", "include", "earn", "bet", "calm", "direct", "sweet", "thick", "abstract", "someday", "nowadays", "lawyer", "officer", "university", "level", "growth", "journey", "gun", "emergency", "case", "difficulty", "addition", "credit", "fool", "harvest", "figure", "tie", "boil", "borrow", "belong", "communicate", "survive", "confuse", "handsome", "gentle", "mad", "merry", "noisy", "scientific", "mostly", "anywhere"],
      4: ["action", "talent", "choice", "slave", "situation", "pride", "tip", "stair", "soil", "master", "suit", "notice", "bow", "rush", "adult", "principal", "folk", "material", "standard", "surf", "accept", "obey", "hide", "basic", "local", "boring", "weak", "quick", "easily", "abroad", "hero", "ability", "knowledge", "technique", "floor", "cancer", "diet", "garbage", "cash", "countryside", "route", "amount", "score", "challenge", "cure", "appear", "spread", "hunt", "destroy", "consider", "expect", "suggest", "cultural", "social", "elderly", "unhappy", "crazy", "alive", "outside", "quite"],
      5: ["village", "forest", "leaf", "vegetable", "office", "machine", "area", "piece", "grace", "spring", "rock", "line", "exercise", "end", "cook", "fall", "front", "second", "cold", "happen", "leave", "remember", "wear", "move", "send", "large", "hot", "early", "often", "sometimes", "neighbor", "pet", "bottle", "art", "poem", "subject", "weekend", "price", "custom", "fact", "rule", "break", "check", "stay", "bring", "build", "join", "die", "half", "few", "both", "sick", "busy", "real", "wrong", "most", "late", "together", "even"],
      6: ["host", "athlete", "audience", "temperature", "cell", "transportation", "bowl", "brick", "planet", "tail", "wing", "purpose", "decision", "frighten", "scare", "slip", "melt", "pollute", "affect", "depend", "manage", "fit", "correct", "surprising", "active", "colorful", "wet", "wild", "daily", "straight", "god", "guest", "diver", "blood", "pool", "temple", "thought", "crop", "sheet", "quarter", "crowd", "care", "strike", "relative", "patient", "gain", "provide", "dig", "explore", "warn", "recognize", "celebrate", "stupid", "helpful", "convenient", "impossible", "medical", "outdoor", "forever", "indeed"],
      7: ["library", "museum", "ocean", "bone", "bath", "pity", "proverb", "product", "invention", "technology", "trash", "moment", "date", "taste", "balance", "ring", "share", "return", "lift", "raise", "explain", "marry", "exciting", "common", "global", "regular", "serious", "fresh", "probably", "else", "peace", "beauty", "sight", "nation", "foreigner", "band", "magazine", "storm", "straw", "disease", "respect", "reply", "record", "cheer", "shake", "key", "square", "wake", "discover", "solve", "continue", "burn", "simple", "quiet", "traditional", "international", "huge", "amazing", "instead", "suddenly"],
      8: ["bird", "restaurant", "trip", "vacation", "space", "street", "side", "paper", "newspaper", "face", "mind", "change", "visit", "start", "watch", "light", "present", "middle", "favorite", "enjoy", "win", "understand", "warm", "clean", "own", "interesting", "famous", "special", "fast", "only", "nature", "state", "island", "group", "soldier", "habit", "culture", "history", "information", "advertisement", "science", "war", "store", "sound", "point", "land", "turn", "fly", "begin", "grow", "believe", "worry", "save", "please", "easy", "poor", "such", "just", "back", "always"],
      9: ["environment", "pollution", "lake", "desert", "insect", "accident", "college", "exam", "advice", "hobby", "form", "mark", "board", "post", "laugh", "excuse", "pass", "drive", "receive", "kill", "climb", "add", "fat", "dark", "whole", "afraid", "physical", "dangerous", "off", "over", "clerk", "foot", "company", "garage", "palace", "hole", "bill", "seed", "medicine", "luck", "meaning", "volunteer", "view", "lie", "act", "pay", "shout", "cross", "seem", "invite", "arrive", "collect", "rich", "blind", "heavy", "terrible", "strange", "possible", "maybe", "ago"],
      10: ["sense", "truth", "pleasure", "success", "image", "friendship", "map", "being", "project", "goods", "traffic", "coin", "safety", "bank", "spaceship", "address", "rainbow", "electricity", "million", "law", "model", "campaign", "type", "sentence", "block", "heat", "seat", "circle", "touch", "reach", "wonder", "mix", "excite", "magic", "rise", "secret", "lead", "general", "prepare", "enter", "imagine", "award", "fill", "forget", "produce", "develop", "cool", "recycle", "slow", "several", "clear", "funny", "false", "safe", "enough", "national", "loud", "main", "far", "almost", "finally"],
      11: ["president", "diary", "teenager", "cartoon", "arm", "skill", "meal", "character", "factory", "reason", "prize", "chance", "ground", "shape", "community", "difference", "glass", "wall", "weight", "contest", "control", "race", "step", "smell", "matter", "match", "judge", "interest", "set", "cause", "catch", "cover", "hold", "travel", "pick", "guess", "teach", "finish", "agree", "wash", "invent", "introduce", "welcome", "tired", "smart", "hurt", "bright", "proud", "wise", "dirty", "hungry", "angry", "fine", "modern", "pretty", "useful", "still", "soon", "later", "once"]
    };

    let pagesData = {};
    let currentPage = 1;
    let isPlaying = false;

    function buildDatabase() {
      for (let p = 1; p <= 11; p++) {
        pagesData[p] = rawWords[p].map((word, idx) => ({
          page: p,
          num: idx + 1,
          vocab: word,
          en: `Learning the English word ${word} helps expand your sentence building skills.`,
          read: `เลิร์น-นิ่ง ดิ อิง-กลิช เวิร์ด ${word} เฮลป์ส เอ็ก-สแพนด์ ยัวร์ เซน-เทนส์ บิล-ดิ้ง สกิลส์`,
          th: `การเรียนรู้คำว่า "${word}" ช่วยพัฒนาทักษะการสร้างประโยคของคุณ`
        }));
      }
    }

    function toggleMusic() {
      const audio = document.getElementById('lofi-audio');
      const btn = document.getElementById('music-play-btn');
      if (!audio) return;

      if (isPlaying) {
        audio.pause();
        isPlaying = false;
        btn.innerHTML = '▶️ เล่นเพลง';
        btn.classList.replace('bg-pink-600', 'bg-purple-600');
      } else {
        audio.play().then(() => {
          isPlaying = true;
          btn.innerHTML = '⏸️ หยุดเพลง';
          btn.classList.replace('bg-purple-600', 'bg-pink-600');
        }).catch(err => {
          console.error("Audio playback error:", err);
          alert("ไม่สามารถเล่นเสียงได้ กรุณาลองใหม่อีกครั้ง");
        });
      }
    }

    function speakText(text) {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const cleanText = text.replace(/<\/?[^>]+(>|$)/g, "");
        const utterance = new SpeechSynthesisUtterance(cleanText);
        utterance.lang = 'en-US';
        utterance.rate = 0.85;
        utterance.pitch = 1.0;
        window.speechSynthesis.speak(utterance);
      }
    }

    function togglePassVisibility(fieldIds, btn) {
      let isVisible = false;
      fieldIds.forEach(id => {
        const input = document.getElementById(id);
        if (input) {
          if (input.type === 'password') {
            input.type = 'text';
            isVisible = true;
          } else {
            input.type = 'password';
          }
        }
      });
      btn.innerText = isVisible ? '🙈' : '👁️';
    }

    function syncSignupPassword(val) {
      const confirmInput = document.getElementById('signup-pass-confirm');
      if (confirmInput) {
        confirmInput.value = val;
      }
    }

    function toggleAuth(target) {
      const loginCard = document.getElementById('login-card');
      const signupCard = document.getElementById('signup-card');
      if (loginCard && signupCard) {
        loginCard.classList.toggle('hidden', target !== 'login');
        signupCard.classList.toggle('hidden', target !== 'signup');
      }
    }

    function triggerProcessingModal(title, statusMsg, icon = "🛡️", callback) {
      const modal = document.getElementById('processing-modal');
      const modalTitle = document.getElementById('modal-title');
      const modalStatus = document.getElementById('modal-status');
      const modalIcon = document.getElementById('modal-icon');
      
      modalTitle.innerText = title;
      modalStatus.innerText = statusMsg;
      if (modalIcon) modalIcon.innerText = icon;
      modal.classList.remove('hidden');

      setTimeout(() => {
        modalStatus.innerText = "กำลังประมวลผลข้อมูล...";
      }, 600);

      setTimeout(() => {
        modal.classList.add('hidden');
        if (callback) callback();
      }, 1200);
    }

    function openLogoutConfirmModal() {
      document.getElementById('logout-confirm-modal').classList.remove('hidden');
    }

    function closeLogoutConfirmModal() {
      document.getElementById('logout-confirm-modal').classList.add('hidden');
    }

    function confirmLogout() {
      closeLogoutConfirmModal();
      const audio = document.getElementById('lofi-audio');
      if (audio && isPlaying) {
        audio.pause();
        isPlaying = false;
      }
      triggerProcessingModal("กำลังออกจากระบบ...", "กำลังดำเนินการออกจากระบบความปลอดภัย", "👋", () => {
        localStorage.removeItem('active_user');
        checkSession();
      });
    }

    function handleSignup(e) {
      e.preventDefault();
      const name = document.getElementById('signup-name').value.trim();
      const email = document.getElementById('signup-email').value.trim();
      const pass = document.getElementById('signup-pass').value;
      const passConfirm = document.getElementById('signup-pass-confirm').value;
      const errorMsg = document.getElementById('signup-error-msg');

      const wipePasswordFields = () => {
        document.getElementById('signup-pass').value = '';
        document.getElementById('signup-pass-confirm').value = '';
        document.getElementById('signup-pass').focus();
      };

      const hasLetter = /[a-zA-Z]/.test(pass);
      const hasNumber = /[0-9]/.test(pass);

      if (pass.length < 8 || !hasLetter || !hasNumber) {
        errorMsg.innerText = "❌ รหัสผ่านต้องมีความยาวอย่างน้อย 8 ตัวอักษร และต้องประกอบด้วยทั้งตัวอักษรและตัวเลข";
        errorMsg.classList.remove('hidden');
        wipePasswordFields();
        return;
      }

      if (pass !== passConfirm) {
        errorMsg.innerText = "❌ รหัสผ่านและรหัสผ่านยืนยันไม่ตรงกัน กรุณากรอกใหม่อีกครั้ง";
        errorMsg.classList.remove('hidden');
        wipePasswordFields();
        return;
      }

      errorMsg.classList.add('hidden');

      triggerProcessingModal("กำลังลงทะเบียน...", "กำลังบันทึกข้อมูลความปลอดภัยบัญชีของคุณ", "✨", () => {
        const userObj = { name, email, pass };
        localStorage.setItem(`user_${email}`, JSON.stringify(userObj));
        alert("🎉 สมัครสมาชิกสำเร็จ! กรุณาเข้าสู่ระบบ");
        toggleAuth('login');
      });
    }

    function handleLogin(e) {
      e.preventDefault();
      const email = document.getElementById('login-email').value.trim();
      const pass = document.getElementById('login-pass').value;
      const errorMsg = document.getElementById('login-error-msg');

      const wipeLoginPass = () => {
        document.getElementById('login-pass').value = '';
        document.getElementById('login-pass').focus();
      };

      const stored = localStorage.getItem(`user_${email}`);
      if (!stored) {
        errorMsg.innerText = "❌ ไม่พบบัญชีผู้ใช้งานนี้ในระบบ กรุณาตรวจสอบอีเมลอีกครั้ง";
        errorMsg.classList.remove('hidden');
        wipeLoginPass();
        return;
      }

      const userObj = JSON.parse(stored);
      if (userObj.pass !== pass) {
        errorMsg.innerText = "❌ รหัสผ่านไม่ถูกต้อง กรุณาลองใหม่อีกครั้ง";
        errorMsg.classList.remove('hidden');
        wipeLoginPass();
        return;
      }

      errorMsg.classList.add('hidden');

      triggerProcessingModal("กำลังเข้าสู่ระบบ...", "กำลังยืนยันตัวตนกับระบบความปลอดภัย", "🚀", () => {
        localStorage.setItem('active_user', JSON.stringify(userObj));
        checkSession();
      });
    }

    function checkSession() {
      const active = localStorage.getItem('active_user');
      if (active) {
        const user = JSON.parse(active);
        document.getElementById('user-display').innerText = `สวัสดี, ${user.name}`;
        document.getElementById('auth-view').classList.add('hidden');
        document.getElementById('main-view').classList.remove('hidden');
        renderTabs();
        renderSentences();
      } else {
        document.getElementById('auth-view').classList.remove('hidden');
        document.getElementById('main-view').classList.add('hidden');
      }
    }

    function renderTabs() {
      const tabs = document.getElementById('page-tabs');
      tabs.innerHTML = Array.from({ length: 11 }, (_, i) => i + 1).map(p => `
        <button onclick="switchPage(${p})" class="px-3 py-1.5 md:px-4 md:py-2 rounded-xl text-xs md:text-sm font-bold transition-all ${
          currentPage === p
            ? 'gradient-btn text-white shadow-md scale-105'
            : 'bg-white/80 text-purple-700 hover:bg-purple-100 border border-purple-100'
        }">หน้า ${p}</button>
      `).join('');
    }

    function switchPage(p) {
      currentPage = p;
      document.getElementById('search-input').value = '';
      renderTabs();
      renderSentences();
    }

    function renderSentences(dataList = pagesData[currentPage], query = '') {
      const container = document.getElementById('sentences-container');
      const noResults = document.getElementById('no-results');

      if (!dataList || dataList.length === 0) {
        container.innerHTML = '';
        noResults.classList.remove('hidden');
        return;
      }

      noResults.classList.add('hidden');

      container.innerHTML = dataList.map(item => {
        let sentenceText = item.en;
        let vocabText = item.vocab;

        if (query) {
          const reg = new RegExp(`(${query})`, 'gi');
          sentenceText = sentenceText.replace(reg, `<span class="highlight-match">$1</span>`);
          vocabText = vocabText.replace(reg, `<span class="highlight-match">$1</span>`);
        } else {
          const vocabReg = new RegExp(`(${item.vocab})`, 'gi');
          sentenceText = sentenceText.replace(vocabReg, `<b class="text-pink-600 font-bold">$1</b>`);
        }

        return `
          <div class="bg-white/90 backdrop-blur-md p-4 md:p-5 rounded-2xl border border-purple-100 shadow-md flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="space-y-1.5 flex-grow">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-xs bg-purple-100 text-purple-700 px-2.5 py-0.5 rounded-lg font-bold">
                  หน้า ${item.page} - ข้อ ${item.num}
                </span>
                <span class="text-xs bg-pink-100 text-pink-700 px-2 py-0.5 rounded-lg font-bold">
                  ${vocabText}
                </span>
              </div>
              <div class="text-base md:text-lg font-medium text-slate-800 leading-snug">
                ${sentenceText}
              </div>
              <div class="text-xs md:text-sm text-purple-600 font-medium">
                🗣️ คำอ่าน: [ ${item.read} ]
              </div>
              <div class="text-xs md:text-sm font-bold text-pink-600">
                🇹🇭 คำแปล: ${item.th}
              </div>
            </div>
            <button onclick="speakText('${item.en.replace(/'/g, "\\'")}')" 
              class="w-11 h-11 rounded-xl gradient-btn text-white flex items-center justify-center text-lg shadow-md active:scale-95 transition flex-shrink-0 self-end sm:self-center"
              title="ฟังเสียงอ่าน">
              🔊
            </button>
          </div>
        `;
      }).join('');
    }

    function handleSearch() {
      const query = document.getElementById('search-input').value.trim().toLowerCase();
      
      if (!query) {
        renderSentences(pagesData[currentPage]);
        return;
      }

      let matches = [];
      for (let p = 1; p <= 11; p++) {
        const pageMatches = pagesData[p].filter(item => 
          item.vocab.toLowerCase().includes(query) ||
          item.en.toLowerCase().includes(query) ||
          item.read.toLowerCase().includes(query) ||
          item.th.toLowerCase().includes(query)
        );
        matches = matches.concat(pageMatches);
      }

      renderSentences(matches, query);
    }

    window.addEventListener('DOMContentLoaded', () => {
      buildDatabase();
      checkSession();
    });
  </script>
</body>
</html>
